diff --git a/test/views/dsha_agent_test.dart b/test/views/dsha_agent_test.dart
new file mode 100644
index 0000000..5b2b2d0
--- /dev/null
+++ b/test/views/dsha_agent_test.dart
@@ -0,0 +1,81 @@
+import 'dart:convert';
+
+import 'package:fl_clash/common/dsha_agent.dart';
+import 'package:fl_clash/ui/ui.dart';
+import 'package:fl_clash/views/dsha_agent.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../helpers/test_app.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Map<String, bool> policy;
+  var failWrite = false;
+  final calls = <String>[];
+
+  setUp(() {
+    policy = {'start': false, 'nodes': false, 'rules': false};
+    calls.clear();
+    failWrite = false;
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(dshaAgentChannel, (call) async {
+          if (call.method == 'setPolicy') {
+            calls.add(call.arguments['key'] as String);
+            if (failWrite) throw PlatformException(code: 'disk_error');
+            policy[call.arguments['key'] as String] =
+                call.arguments['value'] as bool;
+          }
+          return jsonEncode(policy);
+        });
+  });
+
+  tearDown(() {
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(dshaAgentChannel, null);
+  });
+
+  testWidgets('permission rows write independently and survive reopening', (
+    tester,
+  ) async {
+    await tester.pumpWidget(
+      const TestApp(wrapInProviderScope: true, child: DshaAgentView()),
+    );
+    await tester.pumpAndSettle();
+    expect(find.byType(ListItem), findsNWidgets(3));
+    await tester.tap(find.text('Allow Agent to switch nodes'));
+    await tester.pumpAndSettle();
+    expect(policy, {'start': false, 'nodes': true, 'rules': false});
+    expect(calls, ['nodes']);
+    await tester.pumpWidget(const SizedBox.shrink());
+    await tester.pumpWidget(
+      const TestApp(wrapInProviderScope: true, child: DshaAgentView()),
+    );
+    await tester.pumpAndSettle();
+    expect(tester.widget<Switch>(find.byType(Switch).at(1)).value, isTrue);
+    await tester.tap(find.text('Allow Agent to switch nodes'));
+    await tester.pumpAndSettle();
+    expect(policy['nodes'], isFalse);
+  });
+
+  testWidgets(
+    'failed permission save keeps previous state and reports failure',
+    (tester) async {
+      failWrite = true;
+      await tester.pumpWidget(
+        const TestApp(wrapInProviderScope: true, child: DshaAgentView()),
+      );
+      await tester.pumpAndSettle();
+      await tester.tap(find.text('Allow Agent to start and stop the proxy'));
+      await tester.pumpAndSettle();
+      expect(policy['start'], isFalse);
+      expect(
+        find.text(
+          'The operation did not complete. Check FlClash and try again.',
+        ),
+        findsOneWidget,
+      );
+    },
+  );
+}
