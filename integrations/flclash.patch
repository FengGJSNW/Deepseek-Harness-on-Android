new file mode 100644
index 0000000..e4003f8
--- /dev/null
+++ b/test/common/dsha_agent_scope_test.dart
@@ -0,0 +1,64 @@
+import 'dart:async';
+
+import 'package:fl_clash/common/dsha_agent_scope.dart';
+import 'package:fl_clash/plugins/service.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  const channel = MethodChannel('com.follow.clash/service');
+  var permitted = true;
+  var starts = 0;
+
+  setUp(() {
+    permitted = true;
+    starts = 0;
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(channel, (call) async {
+          if (call.method == 'start') {
+            if (call.arguments case final Map envelope) {
+              expect(envelope['requestId'], 'pending-agent');
+              if (!permitted) throw PlatformException(code: 'AGENT_PERMISSION');
+            }
+            starts++;
+          }
+          return true;
+        });
+  });
+
+  tearDown(
+    () => TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(channel, null),
+  );
+
+  test(
+    'delayed Agent start retains its identity through the service boundary',
+    () async {
+      final waiting = Completer<void>();
+      final operation = withDshaRequest('pending-agent', () async {
+        await waiting.future;
+        return Service().start();
+      });
+      expect(dshaRequestId, isNull);
+      permitted = false;
+      final rejection = expectLater(
+        operation,
+        throwsA(isA<PlatformException>()),
+      );
+      waiting.complete();
+      await rejection;
+      expect(starts, 0);
+    },
+  );
+
+  test(
+    'manual service controls are independent from Agent permission',
+    () async {
+      permitted = false;
+      expect(dshaServiceCommand(7), 7);
+      expect(await Service().start(), isTrue);
+      expect(starts, 1);
+    },
+  );
+}
