diff --git a/lib/common/dsha_agent.dart b/lib/common/dsha_agent.dart
new file mode 100644
index 0000000..e4ac8a1
--- /dev/null
+++ b/lib/common/dsha_agent.dart
@@ -0,0 +1,249 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:fl_clash/common/common.dart';
+import 'package:fl_clash/common/dsha_agent_scope.dart';
+import 'package:fl_clash/database/database.dart';
+import 'package:fl_clash/models/models.dart';
+import 'package:fl_clash/providers/providers.dart';
+import 'package:fl_clash/plugins/service.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+const dshaEmbedded = bool.fromEnvironment('DSHA_EMBEDDED');
+const dshaAgentChannel = MethodChannel('dev.deepseek.mobile/flclash_agent');
+
+Future<void> prepareDshaHost() async {
+  AppPath.useEmbeddedStorage();
+  await dshaAgentChannel.invokeMethod<void>('bootstrap');
+}
+
+class DshaAgentBridge {
+  DshaAgentBridge(this.container);
+  final ProviderContainer container;
+  Future<void>? _migration;
+  int _routeRevision = 0;
+
+  void attach() {
+    container.listen(proxyStateProvider, (_, state) {
+      unawaited(
+        dshaAgentChannel.invokeMethod<void>('route', {
+          'revision': ++_routeRevision,
+          'running': state.isStart,
+          'port': state.port,
+        }),
+      );
+    }, fireImmediately: true);
+    container.listen(initProvider, (_, initialized) {
+      if (initialized) {
+        _migration ??= _migrateProfiles();
+        unawaited(
+          _migration!.catchError((Object error) {
+            commonPrint.log(
+              'DSHA profile migration failed: ${error.runtimeType}',
+            );
+          }),
+        );
+      }
+    }, fireImmediately: true);
+    dshaAgentChannel.setMethodCallHandler((call) async {
+      if (call.method != 'command') throw MissingPluginException();
+      final args = jsonDecode(call.arguments as String) as Map<String, dynamic>;
+      for (
+        var attempt = 0;
+        !container.read(initProvider) && attempt < 100;
+        attempt++
+      ) {
+        await _check(args);
+        await Future<void>.delayed(const Duration(milliseconds: 100));
+      }
+      if (!container.read(initProvider)) {
+        throw PlatformException(
+          code: 'initialize',
+          message: currentAppLocalizations.dshaOpenFirst,
+        );
+      }
+      await _migration;
+      return withDshaRequest(
+        args['requestId'] as String,
+        () async => jsonEncode(await _command(args)),
+      );
+    });
+    unawaited(dshaAgentChannel.invokeMethod<void>('ready'));
+  }
+
+  Future<void> _check(Map<String, dynamic> args) async {
+    await dshaAgentChannel.invokeMethod<bool>('check', args['requestId']);
+  }
+
+  Future<Map<String, Object?>> _command(Map<String, dynamic> args) async {
+    await _check(args);
+    final action = args['action'] as String;
+    final setup = container.read(setupActionProvider.notifier);
+    final core = container.read(coreHandlerProvider);
+    switch (action) {
+      case 'status':
+        final data = await core.getProxies();
+        final permissions = jsonDecode(
+          (await dshaAgentChannel.invokeMethod<String>('policy'))!,
+        );
+        return {
+          'running': await service?.getRunTime() != null,
+          'mode': container.read(patchClashConfigProvider).mode.name,
+          'hasProfile': container.read(currentProfileProvider) != null,
+          'canStart': permissions['start'],
+          'canSelectNode': permissions['nodes'],
+          'canEditRules': permissions['rules'],
+          'groups': [
+            for (final entry
+                in data.proxies.entries
+                    .where((e) => e.value is Map && e.value['all'] is List)
+                    .take(30))
+              {
+                'name': entry.key,
+                'type': entry.value['type'],
+                'now': entry.value['now'],
+                'nodes': (entry.value['all'] as List).take(60).toList(),
+              },
+          ],
+        };
+      case 'start':
+      case 'stop':
+        final running = action == 'start';
+        if (running && container.read(currentProfileProvider) == null) {
+          throw MessageException(currentAppLocalizations.dshaProfileRequired);
+        }
+        if (running) {
+          if (container.read(safeModeProvider)) {
+            throw const MessageException('FlClash 处于安全模式，请退出安全模式后重试');
+          }
+          if (container.read(suspendProvider)) {
+            throw const MessageException('当前网络在 FlClash 的暂停列表中，请调整网络设置后重试');
+          }
+          final vpn = await container.read(vpnOptionsProvider.future);
+          await dshaAgentChannel.invokeMethod<bool>('prepareStart', {
+            'requestId': args['requestId'],
+            'vpn': vpn.enable,
+          });
+          await _check(args);
+          // The Flutter activity may be detached: synchronize the current VPN options now,
+          // instead of relying on the UI listener's unawaited shared-state update.
+          final syncError = await service?.syncState(
+            container.read(sharedStateProvider),
+          );
+          if (syncError == null || syncError.isNotEmpty) {
+            throw const MessageException('FlClash 服务未就绪，请打开 FlClash 完成初始化');
+          }
+          if (!await setup.applyProfile(silence: true)) {
+            throw const MessageException('当前代理配置未能加载，请在 FlClash 检查配置');
+          }
+        }
+        await _check(args);
+        if (!await setup.setRunning(running)) {
+          throw MessageException(currentAppLocalizations.dshaOperationFailed);
+        }
+        for (var attempt = 0; attempt < 100; attempt++) {
+          await _check(args);
+          if ((await service?.getRunTime() != null) == running) {
+            return {'running': running};
+          }
+          await Future<void>.delayed(const Duration(milliseconds: 100));
+        }
+        throw MessageException(
+          running ? '代理未进入运行状态，请检查 FlClash 日志中的启动错误' : '代理未停止，可能已有新的启动请求',
+        );
+      case 'select':
+        final group = args['group'] as String;
+        final node = args['node'] as String;
+        final before = (await core.getProxies()).proxies[group];
+        if (before is! Map ||
+            before['all'] is! List ||
+            !(before['all'] as List).contains(node)) {
+          throw MessageException(currentAppLocalizations.dshaInvalidSelection);
+        }
+        await _check(args);
+        await container
+            .read(proxiesActionProvider.notifier)
+            .changeProxy(groupName: group, proxyName: node);
+        final after = (await core.getProxies()).proxies[group];
+        if (after is! Map || after['now'] != node) {
+          throw MessageException(currentAppLocalizations.dshaOperationFailed);
+        }
+        return {'group': group, 'node': node};
+      case 'rule':
+        final profileId = container.read(currentProfileIdProvider);
+        if (profileId == null) {
+          throw MessageException(currentAppLocalizations.dshaProfileRequired);
+        }
+        final type = (args['type'] as String? ?? 'DOMAIN-SUFFIX').toUpperCase();
+        final domain = args['domain'] as String;
+        final target = args['target'] as String;
+        if (!{'DOMAIN', 'DOMAIN-SUFFIX', 'DOMAIN-KEYWORD'}.contains(type) ||
+            domain.isEmpty ||
+            domain.length > 253 ||
+            RegExp(r'[\s,\x00-\x1f]').hasMatch(domain) ||
+            target.isEmpty ||
+            RegExp(r'[\r\n,]').hasMatch(target)) {
+          throw MessageException(currentAppLocalizations.dshaInvalidRule);
+        }
+        final proxies = (await core.getProxies()).proxies;
+        if (!{'DIRECT', 'REJECT'}.contains(target) &&
+            !proxies.containsKey(target)) {
+          throw MessageException(currentAppLocalizations.dshaInvalidSelection);
+        }
+        final existing = await database.rulesDao
+            .queryProfileRules(profileId)
+            .get();
+        final rule = Rule.parse('$type,$domain,$target');
+        if (existing.any(
+          (r) =>
+              r.ruleAction == rule.ruleAction &&
+              r.content == rule.content &&
+              r.ruleTarget == target,
+        )) {
+          return {'saved': true, 'alreadyPresent': true};
+        }
+        await _check(args);
+        await database.rulesDao.putRule(rule, profileId: profileId);
+        await _check(args);
+        final applied = await setup.applyProfile(force: true, silence: true);
+        return {'saved': true, 'applied': applied, 'profileId': profileId};
+      default:
+        throw ArgumentError('Unknown proxy action');
+    }
+  }
+
+  Future<void> _migrateProfiles() async {
+    final raw = await dshaAgentChannel.invokeMethod<String>('legacyProfiles');
+    final rows = jsonDecode(raw ?? '[]') as List;
+    final core = container.read(coreHandlerProvider);
+    for (final row in rows.cast<Map<String, dynamic>>()) {
+      final legacyId = row['id'] as String;
+      final id = int.parse(
+        legacyId.replaceAll('-', '').substring(0, 13),
+        radix: 16,
+      );
+      var profile = await database.profilesDao.get(id);
+      if (profile == null) {
+        profile =
+            Profile.normal(
+              label: row['name'] as String,
+              url: row['source'] as String,
+            ).copyWith(
+              id: id,
+              selectedMap: Map<String, String>.from(row['nodes'] as Map),
+            );
+        profile = await profile.saveFile(
+          Uint8List.fromList(utf8.encode(row['yaml'] as String)),
+          validate: (path, key) => core.validateProfile(path, key),
+        );
+        await database.profilesDao.putAll([profile.toCompanion()]);
+      }
+      container.read(profilesActionProvider.notifier).putProfile(profile);
+      if (row['selected'] == true) {
+        container.read(currentProfileIdProvider.notifier).value = id;
+      }
+      await dshaAgentChannel.invokeMethod<void>('migrated', legacyId);
+    }
+  }
+}
