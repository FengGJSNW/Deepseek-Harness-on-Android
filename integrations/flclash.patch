@@ -0,0 +1,15 @@
+import 'dart:async';
+
+const dshaRequestZoneKey = #dshaAgentRequest;
+
+String? get dshaRequestId => Zone.current[dshaRequestZoneKey] as String?;
+
+Future<T> withDshaRequest<T>(
+  String requestId,
+  Future<T> Function() operation,
+) => runZoned(operation, zoneValues: {dshaRequestZoneKey: requestId});
+
+Object dshaServiceCommand(int revision) => switch (dshaRequestId) {
+  final String id => {'revision': revision, 'requestId': id},
+  null => revision,
+};
