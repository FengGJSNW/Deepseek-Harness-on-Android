diff --git a/lib/views/dsha_agent.dart b/lib/views/dsha_agent.dart
new file mode 100644
index 0000000..555ba89
--- /dev/null
+++ b/lib/views/dsha_agent.dart
@@ -0,0 +1,100 @@
+import 'dart:convert';
+
+import 'package:fl_clash/common/common.dart';
+import 'package:fl_clash/common/dsha_agent.dart';
+import 'package:fl_clash/widgets/widgets.dart';
+import 'package:flutter/widgets.dart';
+
+class DshaAgentView extends StatefulWidget {
+  const DshaAgentView({super.key});
+  @override
+  State<DshaAgentView> createState() => _DshaAgentViewState();
+}
+
+class _DshaAgentViewState extends State<DshaAgentView> {
+  Map<String, dynamic>? _policy;
+  bool _saving = false;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    _load();
+  }
+
+  Future<void> _load() async {
+    try {
+      final value = await dshaAgentChannel.invokeMethod<String>('policy');
+      if (mounted) {
+        setState(() => _policy = jsonDecode(value!) as Map<String, dynamic>);
+      }
+    } catch (error) {
+      if (mounted) setState(() => _error = '$error');
+    }
+  }
+
+  Future<void> _set(String key, bool value) async {
+    if (_saving) return;
+    setState(() => _saving = true);
+    try {
+      final result = await dshaAgentChannel.invokeMethod<String>('setPolicy', {
+        'key': key,
+        'value': value,
+      });
+      if (mounted) {
+        setState(() {
+          _policy = jsonDecode(result!) as Map<String, dynamic>;
+          _error = null;
+        });
+      }
+    } catch (error) {
+      if (mounted) setState(() => _error = '$error');
+    } finally {
+      if (mounted) setState(() => _saving = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final strings = context.appLocalizations;
+    return Scaffold(
+      title: strings.dshaAgentBehavior,
+      body: ListView(
+        padding: EdgeInsets.fromLTRB(
+          16,
+          context.sectionsTopPadding,
+          16,
+          20 + context.bottomInset,
+        ),
+        children: [
+          generateSection(
+            items: [
+              for (final entry in {
+                'start': strings.dshaAllowStart,
+                'nodes': strings.dshaAllowNodes,
+                'rules': strings.dshaAllowRules,
+              }.entries)
+                IgnorePointer(
+                  ignoring: _saving || _policy == null,
+                  child: ListItem.toggle(
+                    title: Text(entry.value),
+                    value: _policy?[entry.key] == true,
+                    onChanged: (value) => _set(entry.key, value),
+                  ),
+                ),
+            ],
+          ),
+          Padding(
+            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
+            child: Text(strings.dshaAgentExplanation),
+          ),
+          if (_error != null)
+            Padding(
+              padding: const EdgeInsets.all(12),
+              child: Text(strings.dshaOperationFailed),
+            ),
+        ],
+      ),
+    );
+  }
+}
