{
  "name": "deepseek-mobile",
  "version": "0.8.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-harness.mjs && node scripts/build-linux.mjs && node scripts/build-console.mjs && node scripts/build-math.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/format-code.ps1",
    "format:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/format-code.ps1 -Check",
    "verify:web": "node scripts/verify.mjs --web",
    "verify": "node scripts/verify.mjs",
    "verify:release": "node scripts/verify.mjs --release"
  },
  "devDependencies": {
    "buffer": "6.0.3",
    "esbuild": "0.25.12",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "core-js": "3.51.0",
    "katex": "0.19.1",
    "unicode-segmenter": "0.17.3",
    "v86": "0.5.473"
  }
}
