{
  "name": "deepseek-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-harness.mjs && node scripts/build-linux.mjs && node scripts/build-console.mjs && node scripts/build-math.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/format-code.ps1",
    "format:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/format-code.ps1 -Check"
  },
  "devDependencies": {
    "buffer": "6.0.3",
    "esbuild": "0.25.12",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "katex": "0.19.1",
    "v86": "0.5.473"
  }
}
