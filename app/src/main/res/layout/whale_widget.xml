<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/whale_chibi_expanded" android:contentDescription="打开 DSHA" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DSHA" android:textColor="#426EFE" android:textStyle="bold" android:textSize="16sp" />
            <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#222222" android:textSize="12sp" android:maxLines="2" />
            <TextView android:id="@+id/widget_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#777777" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <Button android:id="@+id/widget_stop" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:background="@drawable/widget_stop_background" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:text="中断并暂停队列" android:textAllCaps="false" android:textColor="#426EFE" android:textSize="12sp" />
</LinearLayout>
